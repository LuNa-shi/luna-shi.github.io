flowchart LR
  user["User request"] --> context

  subgraph harness["Harness (logical boundary)"]
    direction LR

    context["Context assembly<br/>System instructions · History · Available tools"]
    loop["Agent Loop<br/>Request model · Choose next action"]
    safety["Safety controls<br/>Approval · Pre-execution checks · Sandbox"]
    tools["Tool execution<br/>Parse call · Run tool · Normalize result"]
    state["Task state<br/>Append-only event log · Resume and branch"]

    context -->|"What this step can see"| loop
    loop -->|"Tool request"| safety
    safety -->|"Allowed to run"| tools
    tools -->|"Actual result"| state
    loop -->|"Message and step events"| state
    state -->|"Rebuild next context"| context
  end

  tools <-->|"Real operations"| world["File system · Shell · External services"]
  note["Analysis diagram: responsibilities, not processes or deployment topology"]
  note -.-> harness

  classDef core fill:#172033,color:#ffffff,stroke:#172033,stroke-width:2px;
  classDef contextStyle fill:#e7f0ff,color:#1a2a44,stroke:#7aa2d6,stroke-width:2px;
  classDef safetyStyle fill:#fff0e8,color:#4d2a1c,stroke:#d38b65,stroke-width:2px;
  classDef toolStyle fill:#e8f5ee,color:#173b29,stroke:#6ea887,stroke-width:2px;
  classDef stateStyle fill:#f1ecff,color:#30245a,stroke:#9582cc,stroke-width:2px;
  classDef outside fill:#f7f7f5,color:#333333,stroke:#b7b7b0,stroke-width:1.5px;
  classDef noteStyle fill:#fffdf5,color:#5d5542,stroke:#c9bd91,stroke-dasharray:4 3;

  class loop core;
  class context contextStyle;
  class safety safetyStyle;
  class tools toolStyle;
  class state stateStyle;
  class user,world outside;
  class note noteStyle;
